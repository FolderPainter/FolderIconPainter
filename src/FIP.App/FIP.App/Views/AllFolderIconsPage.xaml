<Page
    x:Class="FIP.App.Views.AllFolderIconsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FIP.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:usercontrols="using:FIP.App.UserControls"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
	xmlns:viewmodels="using:FIP.App.ViewModels" xmlns:models="using:FIP.Core.ViewModels"
	DataContext="{x:Bind ViewModel, Mode=OneWay}"
    mc:Ignorable="d">

	<Page.Resources>
		<CollectionViewSource x:Name="itemsCVS" IsSourceGrouped="true" />

		<DataTemplate x:Key="WrapTemplate" x:DataType="viewmodels:DropZoneViewModel">
			<usercontrols:DropZone Margin="8"
								   ShowIconMode="{Binding ElementName=ShowIconsCheckBox, Path=IsChecked}"
								   ShowNameMode="{Binding ElementName=ShowNamesCheckBox, Path=IsChecked}"
								   IconViewModel="{Binding CustomIconVM}"
								   BackgroundColor="{Binding BackgroundColor}"
                                   BackgroundPointerOverColor="{Binding BackgroundPointerOverColor}"
                                   BackgroundPressedColor="{Binding BackgroundPressedColor}">

			</usercontrols:DropZone>
		</DataTemplate>
	
		<DataTemplate x:Key="CategoryListViewTemplate" x:DataType="models:CategoryViewModel">
			<TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
		</DataTemplate>
	</Page.Resources>

	<!--  This grid acts as a root panel for the page.  -->
	<Grid Background="{ThemeResource HomePageBackgroundBrush}" Padding="48,12,12,36">
		<VisualStateManager.VisualStateGroups>
			<!--  Visual states reflect the application's window size  -->
			<VisualStateGroup x:Name="LayoutVisualStates">
				<VisualState x:Name="WideLayout">
					<VisualState.StateTriggers>
						<AdaptiveTrigger MinWindowWidth="{StaticResource Breakpoint640Plus}" />
					</VisualState.StateTriggers>
				</VisualState>
				<VisualState x:Name="NarrowLayout">
					<VisualState.StateTriggers>
						<AdaptiveTrigger MinWindowWidth="0" />
					</VisualState.StateTriggers>
					<VisualState.Setters>
						<Setter Target="WrapScrollParent.Padding" Value="0,0,0,36" />
						<Setter Target="WrapScrollParent.Margin" Value="0,-64,0,0" />
					</VisualState.Setters>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="190"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		
		<Grid.RowDefinitions>
			<RowDefinition Height="auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		
		<ListView x:Name="CategoryList" SelectionMode="Multiple" ItemsSource="{x:Bind ViewModel.Categories}"
				  Margin="-16,43,0,0" ItemTemplate="{StaticResource CategoryListViewTemplate}"
				  SelectionChanged="ListViewSelectionChanged" Grid.Row="0" Grid.Column="0"
				  Grid.RowSpan="2">
		
			<ListView.Header>
				<TextBlock
				x:Name="pageSubtitle"
				Margin="16,0,0,8"
				AutomationProperties.HeadingLevel="Level1"
				Style="{StaticResource SubtitleTextBlockStyle}"
				Text="Category Filter" />
			</ListView.Header>
		
		</ListView>

		<Grid Margin="0,43,32,0" Grid.Row="0" Grid.Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBox x:Name="GridViewFilter" TextAlignment="Start"
					 PlaceholderText="Filter by Icon Name" HorizontalAlignment="Stretch"
					TextChanged="GridViewFilterTextChanged"
					Loaded="GridViewSearchBoxLoaded">
				</TextBox>

				<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
					<CheckBox x:Name="ShowIconsCheckBox" Content="Show Icons" />
					<CheckBox x:Name="ShowNamesCheckBox" Content="Show Names" />
				</StackPanel>
			</Grid>

			<controls:AdaptiveGridView x:Name="AdaptiveGridViewControl"
									   Margin="0,8,32,0" Grid.Row="1" Grid.Column="1"
                                       StretchContentForSingleRow="False"
                                       VerticalContentAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch"
                                       OneRowModeEnabled="False"
                                       SelectionMode="None"
									   ScrollViewer.VerticalScrollBarVisibility="Visible"
									   ScrollViewer.VerticalScrollMode="Auto"
                                       ItemTemplate="{StaticResource WrapTemplate}"
									   ItemsSource="{x:Bind itemsCVS.View, Mode=OneWay}">
						
				<controls:AdaptiveGridView.GroupStyle>
					<GroupStyle>
						<GroupStyle.HeaderTemplate>
							<DataTemplate x:DataType="viewmodels:GroupInfoList">
								<TextBlock
									x:Name="pageSubtitle"
									Style="{StaticResource SubtitleTextBlockStyle}"
									Text="{x:Bind Title}" />
							</DataTemplate>
						</GroupStyle.HeaderTemplate>
					</GroupStyle>
				</controls:AdaptiveGridView.GroupStyle>
			</controls:AdaptiveGridView>

	</Grid>
</Page>
